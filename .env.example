# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.

# Postgres connection string (required).
# Inside Docker, `localhost` points to the container itself.
# Use your Postgres service name or another reachable hostname instead.
DATABASE_URL=postgres://postgres:pass@localhost:5432/supercharger-db

# Private admin import secret for Next.js -> Rust backend calls.
# In production on Render, set this as a secret environment variable.
RUST_INTERNAL_IMPORT_SECRET=replace-with-a-long-random-secret
